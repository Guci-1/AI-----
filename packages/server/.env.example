# AI Panel Studio — 后端环境变量模板
# 用法：复制本文件为 .env 并填入真实值（.env 已被 git 忽略，严禁提交真实 Key）

# LLM Provider：openai | mock（mock 用于单测/E2E，零成本、零网络、确定性输出）
LLM_PROVIDER=mock

# OpenAI 兼容协议 base URL（可切换 DeepSeek / 通义 / Kimi / Ollama 等）
LLM_BASE_URL=

# API Key（占位，切勿填写真实值提交）
LLM_API_KEY=

# 轻量意图模型（专家举手/抢答/反驳等意图，可填更快更便宜的小模型）
LLM_MODEL_INTENT=

# 正式发言模型（专家发言正文 + 主持人发言）
LLM_MODEL_SPEECH=
