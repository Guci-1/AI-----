# 依赖
node_modules/

# 构建产物
dist/
build/
*.tsbuildinfo

# 环境变量（含 API Key，严禁提交）
.env
.env.local
.env.*.local
*.local

# 环境变量模板（唯一豁免，允许入库；真实 Key 严禁提交）
!.env.example

# 数据库（SQLite 文件不入库；开箱演示：npx prisma migrate reset --force && npx prisma db seed）
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 测试产物
coverage/
playwright-report/
test-results/

# ── 必须入库资产（永不 ignore）────────────────────────
# prisma/migrations/              数据库迁移历史，必须提交
# tests/fixtures/                 测试夹具（含 Mock 数据），必须提交
# packages/server/.env.example    环境变量模板，必须提交（见上方豁免）
